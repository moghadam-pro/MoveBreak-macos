<Window x:Class="MoveBreak.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MoveBreak.Controls"
        xmlns:local="clr-namespace:MoveBreak.Views"
        Title="MoveBreak" Width="1050" Height="700" MinWidth="900" MinHeight="620"
        Icon="/Assets/MoveBreak.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <local:HeightConverter x:Key="HeightConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" Opacity=".08" ShadowDepth="2"/></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4F8F86"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid FlowDirection="{Binding LayoutDirection}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="18,18,18,6" Background="Transparent" BorderThickness="0">
            <TabItem Header="{DynamicResource Home}">
                <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource NextBreak}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="18"/>
                                    <TextBlock Text="{Binding Countdown}" HorizontalAlignment="Center" FontSize="76" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" Foreground="#4F8F86" FontSize="16"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                        <Button Style="{StaticResource Primary}" Command="{Binding TogglePauseCommand}" Content="{DynamicResource PauseResume}"/>
                                        <Button Command="{Binding RestartCommand}" Content="{DynamicResource Restart}"/>
                                        <Button Command="{Binding SkipCommand}" Content="{DynamicResource Skip}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource LastSevenDays}" FontSize="18" FontWeight="SemiBold"/>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding WeekValues}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="5">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="WeekBar"
                                                        VerticalAlignment="Bottom"
                                                        Height="{Binding Value, Converter={StaticResource HeightConverter}}"
                                                        MinHeight="5"
                                                        Background="#8CC8BD"
                                                        CornerRadius="6"/>
                                                <TextBlock Grid.Row="1" Text="{Binding Value}" HorizontalAlignment="Center" Margin="0,5,0,1"/>
                                                <TextBlock x:Name="TodayLabel"
                                                           Grid.Row="2"
                                                           Text="{DynamicResource Today}"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Visibility="Hidden"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="WeekBar" Property="Background" Value="{DynamicResource Accent}"/>
                                                    <Setter TargetName="TodayLabel" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource NextExercise}" FontSize="16" Foreground="{DynamicResource MutedBrush}"/>
                                <Image Source="{Binding CurrentExercise.ImagePath}" Height="190" Stretch="UniformToFill" Margin="0,12"/>
                                <TextBlock Text="{Binding CurrentExercise.Title}" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentExercise.Instructions}" TextWrapping="Wrap" Margin="0,8" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Margin="0,4"><Run Text="{DynamicResource ExerciseDuration}"/><Run Text="&#160;"/><Run Text="{Binding CurrentExercise.DurationSeconds}" FontWeight="Bold"/><Run Text="&#160;"/><Run Text="{DynamicResource Seconds}"/></TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Today}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,0"><Run Text="{DynamicResource CompletedBreaks}"/><Run Text="&#160;"/><Run Text="{Binding CompletedToday}" FontWeight="Bold"/></TextBlock>
                                <TextBlock Margin="0,3,0,0"><Run Text="{DynamicResource SittingTime}"/><Run Text="&#160;"/><Run Text="{Binding SittingMinutesToday}" FontWeight="Bold"/><Run Text="&#160;"/><Run Text="{DynamicResource Minutes}"/></TextBlock>
                            </StackPanel>
                        </Border>
                        </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource Exercises}">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Exercises}" Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Image Source="{Binding ImagePath}" Height="110" Stretch="UniformToFill"/>
                                        <StackPanel Grid.Column="1" Margin="20,0">
                                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" Margin="0,8"/>
                                            <TextBlock><Run Text="{DynamicResource Duration}"/><Run Text="&#160;"/><Run Text="{Binding DurationSeconds}"/><Run Text="&#160;"/><Run Text="{DynamicResource Seconds}"/></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource Card}" Width="520" Padding="18" VerticalAlignment="Top" Margin="10,8">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Scheduling}" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Language}" Margin="0,12,0,4"/>
                            <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{DynamicResource ReminderInterval}" Margin="0,9,0,3"/>
                            <controls:MinuteDial Value="{Binding ReminderMinutes, Mode=TwoWay}"
                                                 Width="155"
                                                 Height="155"
                                                 Margin="0,2"
                                                 HorizontalAlignment="Center"
                                                 FlowDirection="LeftToRight"
                                                 FaceBrush="{DynamicResource ControlSurfaceBrush}"
                                                 DialBorderBrush="{DynamicResource ControlBorderBrush}"
                                                 TickBrush="{DynamicResource MutedBrush}"
                                                 HandBrush="{DynamicResource Accent}"
                                                 TextBrush="{DynamicResource ForegroundBrush}"
                                                 CenterBrush="{DynamicResource Surface}"
                                                 FocusRingBrush="{DynamicResource FocusBrush}"
                                                 AutomationProperties.Name="{DynamicResource ReminderInterval}"
                                                 ToolTip="{DynamicResource ReminderInterval}"/>
                            <Border HorizontalAlignment="Center"
                                    Margin="0,2,0,0"
                                    Padding="12,4"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <TextBlock FontSize="15" FlowDirection="{Binding LayoutDirection}">
                                    <Run Text="{Binding ReminderMinutes}" FontWeight="Bold"/><Run Text="&#160;"/><Run Text="{DynamicResource Minutes}"/>
                                </TextBlock>
                            </Border>
                            <CheckBox IsChecked="{Binding EyeRuleEnabled}" Content="{DynamicResource EyeRule}" Margin="0,10,0,3"/>
                            <CheckBox IsChecked="{Binding SoundEnabled}" Content="{DynamicResource Sound}" Margin="0,3"/>
                            <CheckBox IsChecked="{Binding StartWithWindows}" Content="{DynamicResource StartWindows}" Margin="0,3"/>
                            <CheckBox IsChecked="{Binding DarkMode}" Content="{DynamicResource DarkMode}" Margin="0,3"/>
                            <Button Style="{StaticResource Primary}" Command="{Binding SaveSettingsCommand}" Content="{DynamicResource SaveSettings}" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding SettingsMessage}" Foreground="#4F8F86" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1"
                   Margin="18,2,18,10"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}"
                   FontSize="12"
                   FlowDirection="LeftToRight">
            <Run Text="{DynamicResource DevelopedBy}"/><Run Text=" "/><Hyperlink NavigateUri="https://github.com/hedieh-hj"
                                                                                RequestNavigate="OpenGitHub"
                                                                                Foreground="{DynamicResource AccentForegroundBrush}">hedieh-hj</Hyperlink>
        </TextBlock>

        <Border Grid.RowSpan="2" Visibility="{Binding IsBreakVisible, Converter={StaticResource BoolToVisibility}}" Background="#DD1D2927" Panel.ZIndex="10">
            <Border Background="{DynamicResource Surface}" CornerRadius="24" Padding="28" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource TimeToMove}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Image Source="{Binding CurrentExercise.ImagePath}" Height="260" Stretch="Uniform" Margin="0,15"/>
                    <TextBlock Text="{Binding CurrentExercise.Title}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentExercise.Instructions}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10"/>
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,8"><Run Text="{DynamicResource SuggestedDuration}"/><Run Text="&#160;"/><Run Text="{Binding CurrentExercise.DurationSeconds}" FontWeight="Bold"/><Run Text="&#160;"/><Run Text="{DynamicResource Seconds}"/></TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource Primary}" Command="{Binding CompleteCommand}" Content="{DynamicResource Done}"/>
                        <Button Command="{Binding SnoozeCommand}" Content="{DynamicResource SnoozeFive}"/>
                        <Button Command="{Binding SkipCommand}" Content="{DynamicResource Skip}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
